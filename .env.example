# Copy to .env and set a real password. Compose reads .env from this folder.
POSTGRES_USER=your_user
POSTGRES_PASSWORD=your-password
POSTGRES_DB=your_db

# The FastAPI app connects with this URL; use the same user, password and database as above.
DATABASE_URL=postgres://your_user:your-password@localhost:5432/your_db

# blog.http needs this line from v0.4.0 on, with the dev server on http://localhost:8000.
# The REST Client extension sends a Secure session cookie over HTTPS only; without this line, the signed-in requests get 401.
# Only the dev server reads .env, so Cloud Run and the app container keep the Secure cookie. Older versions ignore this line.
IS_COOKIE_SECURE=false
