        <mxCell id="heading" value="&lt;font color=&quot;#7F00FF&quot;&gt;&lt;b&gt;BLOOM &amp;amp; BURR: DATABASE&lt;/b&gt;&lt;/font&gt;" style="text;html=1;fontSize=18;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="80" y="40" width="400" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subheading" value="PostgreSQL 18 · 12 tables · sample rows from &lt;i&gt;db/seed/*.csv&lt;/i&gt;" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="80" y="70" width="600" height="24" as="geometry" />
        </mxCell>
        <mxCell id="note1" value="&lt;b&gt;[NOTE]&lt;/b&gt;&lt;br&gt;Arrows run from the &lt;b&gt;primary key&lt;/b&gt; to the column that references it (&lt;font color=&quot;#616161&quot;&gt;reference&lt;/font&gt;).&lt;br&gt;Every table shows 3 to 5 sample rows only." style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="2720" y="140" width="380" height="100" as="geometry" />
        </mxCell>
        <mxCell id="note2" value="&lt;b&gt;[NOTE]&lt;/b&gt;&lt;br&gt;&lt;b&gt;post_category&lt;/b&gt;, &lt;b&gt;post_tag&lt;/b&gt; and &lt;b&gt;event_speaker&lt;/b&gt; are junction tables: both columns together form the primary key, so each link is stored once. Deleting a post or an event deletes its links (&lt;b&gt;ON DELETE CASCADE&lt;/b&gt;)." style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="3130" y="140" width="380" height="100" as="geometry" />
        </mxCell>
        <mxCell id="note3" value="&lt;b&gt;[NOTE]&lt;/b&gt;&lt;br&gt;Subtypes: every &lt;b&gt;staff&lt;/b&gt; member and every &lt;b&gt;founder&lt;/b&gt; is a &lt;b&gt;person&lt;/b&gt;. There, &lt;b&gt;person_id&lt;/b&gt; is both primary key and reference.&lt;br&gt;An event is online exactly when &lt;b&gt;venue_id&lt;/b&gt; is NULL." style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="3540" y="140" width="380" height="100" as="geometry" />
        </mxCell>
        <mxCell id="legend_title" value="&lt;b&gt;[NOTE]&lt;/b&gt; Colours show the table group. The frame is light; the arrow is a darker shade and has the colour of the table that holds the primary key." style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="2720" y="250" width="1190" height="22" as="geometry" />
