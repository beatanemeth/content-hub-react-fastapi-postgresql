{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"attribution": {
		"commit": ""
	},
	"permissions": {
		"allow": [
			"Bash(node --version)",
			"Bash(npm --version)",
			"Bash(npm ls*)",
			"Bash(git status*)",
			"Bash(git diff*)",
			"Bash(git log*)",
			"Bash(git branch --show-current)",
			"Bash(uv --version)",
			"Bash(uv tree*)",
			"Bash(uv run ruff*)",
			"Bash(uv run pyright*)",
			"Bash(terraform fmt*)",
			"Bash(terraform validate*)",
			"Bash(terraform init -backend=false*)",
			"Bash(terraform test*)"
		],
		"ask": [
			"Bash(npm install*)",
			"Bash(npm i *)",
			"Bash(npm uninstall*)",
			"Bash(npm update*)",
			"Bash(npm ci*)",
			"Bash(npm audit fix*)",
			"Bash(uv init*)",
			"Bash(uv add*)",
			"Bash(uv remove*)",
			"Bash(uv sync*)",
			"Bash(uv lock*)",
			"Bash(git add*)",
			"Bash(git commit*)",
			"Bash(git branch*)",
			"Bash(git restore*)",
			"Bash(git switch*)",
			"Bash(git init*)",
			"Bash(terraform plan*)",
			"Bash(terraform output*)",
			"Bash(gcloud*)"
		],
		"deny": [
			"Bash(npm publish*)",
			"Bash(npm install -g*)",
			"Bash(npm i -g*)",
			"Bash(uv publish*)",
			"Bash(uv tool install*)",
			"Bash(pip install*)",
			"Bash(pip3 install*)",
			"Bash(git push*)",
			"Bash(git pull*)",
			"Bash(git fetch*)",
			"Bash(git clone*)",
			"Bash(git reset --hard*)",
			"Bash(git rebase*)",
			"Bash(git merge*)",
			"Bash(git checkout*)",
			"Bash(git revert*)",
			"Bash(git tag*)",
			"Bash(git clean*)",
			"Bash(git stash drop*)",
			"Bash(docker*)",
			"Bash(terraform apply*)",
			"Bash(terraform destroy*)",
			"Bash(terraform state*)",
			"Bash(terraform import*)",
			"Bash(terraform taint*)",
			"Bash(terraform untaint*)",
			"Bash(terraform force-unlock*)",
			"Bash(gcloud * create*)",
			"Bash(gcloud * update*)",
			"Bash(gcloud * delete*)",
			"Bash(gcloud * deploy*)",
			"Bash(gcloud services enable*)",
			"Bash(gcloud services disable*)",
			"Bash(gcloud * add-iam-policy-binding*)",
			"Bash(gcloud * remove-iam-policy-binding*)",
			"Bash(gcloud * set-iam-policy*)",
			"Bash(cloud-sql-proxy*)",
			"Bash(psql*)",
			"Read(**/.env)",
			"Read(**/terraform.tfvars)",
			"Read(**/backend.hcl)",
			"Read(**/*.tfstate)",
			"Read(**/*.tfstate.*)"
		]
	}
}
