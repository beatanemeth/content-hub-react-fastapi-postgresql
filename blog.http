@baseUrl = http://localhost:8000/api

// The database: docker compose up -d. The server: uv run fastapi dev app/main.py.
// Run both in the project root.
//
// The posts live in PostgreSQL, so what these requests change stays after a server restart.
// To start again from the seed data: docker compose down -v, then docker compose up -d.
//
// REST Client keeps cookies between requests (rest-client.rememberCookiesForSubsequentRequests, on by default).
// So after "Sign in", the requests below it are signed in, until "Sign out".
// Run the sections from top to bottom.

// ---------------------------------
// Test: the read-only lists
// ---------------------------------
### List the staff, to pick a person_id for the sign-in (200, 9 people)
GET {{baseUrl}}/authors

### List the categories (200, 8 categories)
GET {{baseUrl}}/categories

### List the tags (200, 17 tags)
GET {{baseUrl}}/tags


// ---------------------------------
// Test: signed out
// ---------------------------------
### Sign out, to start without a session (204)
POST {{baseUrl}}/mock-logout

### Who is signed in, without a session (401)
GET {{baseUrl}}/me

### Create a post without a session (401)
POST {{baseUrl}}/blog
Content-Type: application/json

{
  "title": "My Coffee Journey",
  "summary": "Exploring unique brews",
  "body": "Content here...",
  "published_on": "2026-11-14",
  "categories": ["SavorTheMoment"],
  "tags": ["Inspiring"]
}

### Replace a post without a session (401)
PUT {{baseUrl}}/blog/1
Content-Type: application/json

{
  "title": "My Coffee Journey",
  "summary": "Exploring unique brews",
  "body": "Content here...",
  "published_on": "2026-11-14",
  "categories": ["SavorTheMoment"],
  "tags": ["Inspiring"]
}

### Delete a post without a session (401)
DELETE {{baseUrl}}/blog/2


// ---------------------------------
// Test: POST /api/mock-login
// ---------------------------------
### Sign in with a fractional person_id (422)
POST {{baseUrl}}/mock-login
Content-Type: application/json

{ "person_id": 1.5 }

### Sign in with a person_id too big for the DB (422)
POST {{baseUrl}}/mock-login
Content-Type: application/json

{ "person_id": 3000000000 }

### Sign in as a person who is not staff (401)
POST {{baseUrl}}/mock-login
Content-Type: application/json

{ "person_id": 10 }

### Sign in as Martha Lindley (200, sets the cookie)
POST {{baseUrl}}/mock-login
Content-Type: application/json

{ "person_id": 1 }

### Who is signed in (200, Martha Lindley)
GET {{baseUrl}}/me


// ---------------------------------
// Test: GET /api/blog
// ---------------------------------
### List all posts, newest first (200, the 13 seed posts: ids 13, 12, …, 1)
GET {{baseUrl}}/blog


// ---------------------------------
// Test: GET /api/blog/{post_id}
// ---------------------------------
### Get one post (200, with body, categories, tags and minutes_to_read)
GET {{baseUrl}}/blog/3

### Get a post that does not exist (404, Post not found)
GET {{baseUrl}}/blog/999

### Get a post with an id that is not a number (422)
GET {{baseUrl}}/blog/abc

### Get a post with id 0 (422)
GET {{baseUrl}}/blog/0

### Get a post with an id too big for the DB (422)
GET {{baseUrl}}/blog/3000000000


// ---------------------------------
// Test: POST /api/blog (signed in as Martha Lindley)
// ---------------------------------
### Create a post (201, the author is Martha Lindley)
POST {{baseUrl}}/blog
Content-Type: application/json

{
  "title": "My Coffee Journey",
  "summary": "Exploring unique brews",
  "body": "Content here...",
  "published_on": "2026-11-14",
  "categories": ["SavorTheMoment", "TasteCloser"],
  "tags": ["Inspiring"]
}

### Create a post with an author_id in the body (201, ignored: the author is still Martha Lindley)
POST {{baseUrl}}/blog
Content-Type: application/json

{
  "title": "My Coffee Journey",
  "summary": "Exploring unique brews",
  "body": "Content here...",
  "author_id": 6,
  "published_on": "2026-11-14",
  "categories": ["SavorTheMoment"],
  "tags": ["Inspiring"]
}

### Create a post with an empty title (422)
POST {{baseUrl}}/blog
Content-Type: application/json

{
  "title": "  ",
  "summary": "Exploring unique brews",
  "body": "Content here...",
  "published_on": "2026-11-14",
  "categories": ["SavorTheMoment", "TasteCloser"],
  "tags": ["Inspiring"]
}

### Create a post with a broken JSON body (422, json_invalid)
POST {{baseUrl}}/blog
Content-Type: application/json

{ "title": "My Coffee Journey" "summary": "a comma is missing" }

### Create a post with a list as the body (422)
POST {{baseUrl}}/blog
Content-Type: application/json

[{ "title": "My Coffee Journey" }]

### Create a post with a NUL character in the title (422: PostgreSQL text cannot hold it)
POST {{baseUrl}}/blog
Content-Type: application/json

{
  "title": "My Coffee\u0000Journey",
  "summary": "Exploring unique brews",
  "body": "Content here...",
  "published_on": "2026-11-14",
  "categories": ["SavorTheMoment"],
  "tags": ["Inspiring"]
}

### Create a post with an impossible date (422)
POST {{baseUrl}}/blog
Content-Type: application/json

{
  "title": "My Coffee Journey",
  "summary": "Exploring unique brews",
  "body": "Content here...",
  "published_on": "2026-02-30",
  "categories": ["SavorTheMoment", "TasteCloser"],
  "tags": ["Inspiring"]
}

### Create a post with an empty category list (422)
POST {{baseUrl}}/blog
Content-Type: application/json

{
  "title": "My Coffee Journey",
  "summary": "Exploring unique brews",
  "body": "Content here...",
  "published_on": "2026-11-14",
  "categories": [],
  "tags": ["Inspiring"]
}

### Create a post with three invalid fields (422, lists all three: title, published_on, tags)
POST {{baseUrl}}/blog
Content-Type: application/json

{
  "title": "",
  "summary": "Exploring unique brews",
  "body": "Content here...",
  "published_on": "not a date",
  "categories": ["SavorTheMoment"],
  "tags": []
}

### Create a post with two unknown category labels (400)
POST {{baseUrl}}/blog
Content-Type: application/json

{
  "title": "My Coffee Journey",
  "summary": "Exploring unique brews",
  "body": "Content here...",
  "published_on": "2026-11-14",
  "categories": ["SavorTheMoment", "NoSuchCategory", "AlsoMissing"],
  "tags": ["Inspiring"]
}

### Create a post with an unknown tag label (400)
POST {{baseUrl}}/blog
Content-Type: application/json

{
  "title": "My Coffee Journey",
  "summary": "Exploring unique brews",
  "body": "Content here...",
  "published_on": "2026-11-14",
  "categories": ["SavorTheMoment"],
  "tags": ["Inspiring", "NoSuchTag"]
}

### Create a post with an unknown category and an unknown tag (400, names the category: categories are checked first)
POST {{baseUrl}}/blog
Content-Type: application/json

{
  "title": "My Coffee Journey",
  "summary": "Exploring unique brews",
  "body": "Content here...",
  "published_on": "2026-11-14",
  "categories": ["NoSuchCategory"],
  "tags": ["NoSuchTag"]
}

### Create a post with a repeated label (saved once) (201)
POST {{baseUrl}}/blog
Content-Type: application/json

{
  "title": "My Coffee Journey",
  "summary": "Exploring unique brews",
  "body": "Content here...",
  "published_on": "2026-11-14",
  "categories": ["SavorTheMoment", "SavorTheMoment"],
  "tags": ["Inspiring"]
}


// ---------------------------------
// Test: PUT /api/blog/{post_id} (signed in as Martha Lindley)
// ---------------------------------
### Replace a post (200, the author stays Daniel Brooks)
PUT {{baseUrl}}/blog/1
Content-Type: application/json

{
  "title": "The 8 Secrets of the Espresso Routine",
  "summary": "Exploring unique brews",
  "body": "Content here...",
  "published_on": "2020-12-28",
  "categories": ["CoffeeStories"],
  "tags": ["EverydayRitual", "BetterTogether"]
}

### Replace a post that does not exist (404)
PUT {{baseUrl}}/blog/999
Content-Type: application/json

{
  "title": "My Coffee Journey",
  "summary": "Exploring unique brews",
  "body": "Content here...",
  "published_on": "2026-11-14",
  "categories": ["SavorTheMoment", "TasteCloser"],
  "tags": ["Inspiring"]
}

### Replace a post with a non-numeric id (422)
PUT {{baseUrl}}/blog/abc
Content-Type: application/json

{
  "title": "My Coffee Journey",
  "summary": "Exploring unique brews",
  "body": "Content here...",
  "published_on": "2026-11-14",
  "categories": ["SavorTheMoment"],
  "tags": ["Inspiring"]
}

### Replace a post that does not exist, with an empty title (422: the body is checked before the post)
PUT {{baseUrl}}/blog/999
Content-Type: application/json

{
  "title": "  ",
  "summary": "Exploring unique brews",
  "body": "Content here...",
  "published_on": "2026-11-14",
  "categories": ["SavorTheMoment"],
  "tags": ["Inspiring"]
}

### Replace a post that does not exist, with an unknown tag (400: the labels are checked before the post)
PUT {{baseUrl}}/blog/999
Content-Type: application/json

{
  "title": "My Coffee Journey",
  "summary": "Exploring unique brews",
  "body": "Content here...",
  "published_on": "2026-11-14",
  "categories": ["SavorTheMoment"],
  "tags": ["NoSuchTag"]
}

### Replace a post with an unknown category label (400, nothing changes)
PUT {{baseUrl}}/blog/1
Content-Type: application/json

{
  "title": "My Coffee Journey",
  "summary": "Exploring unique brews",
  "body": "Content here...",
  "published_on": "2026-11-14",
  "categories": ["SavorTheMoment", "NoSuchCategory"],
  "tags": ["Inspiring"]
}

// ---------------------------------
// Test: DELETE /api/blog/{post_id} (signed in as Martha Lindley)
// ---------------------------------
### Delete a post (204)
DELETE {{baseUrl}}/blog/2

### Get the deleted post (404)
GET {{baseUrl}}/blog/2

### Delete a post that does not exist (404)
DELETE {{baseUrl}}/blog/999


